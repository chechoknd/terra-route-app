# TerraRoute local development defaults.
# Copy this file to .env locally. Never commit real secrets.

APP_ENV=development
HTTP_ADDR=:8080
API_PORT=18080
LOG_LEVEL=debug

POSTGRES_DB=terraroute
POSTGRES_USER=terraroute
POSTGRES_PASSWORD=terraroute_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=55432

# Used by the API container in docker-compose.
API_DATABASE_URL=postgres://terraroute:terraroute_dev_password@postgres:5432/terraroute?sslmode=disable

# Used by local commands running on the host, such as migrations or `make backend-run`.
DATABASE_URL=postgres://terraroute:terraroute_dev_password@localhost:55432/terraroute?sslmode=disable

# Placeholder only. Use a strong secret in your local .env and deployment environment.
JWT_SECRET=replace-with-secure-local-jwt-secret
JWT_EXPIRES_IN=15m
